{
	"name": "soma",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"lint": "biome check . && tsc --noEmit",
		"test": "vitest run",
		"smoke": "node smoke/driver.ts",
