{
	"name": "soma",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"lint": "biome check . && tsc --noEmit",
		"test": "vitest run",
		"smoke": "node smoke/driver.ts",
		"prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then git config --worktree core.hooksPath .githooks; fi",
		"smoke:herdr": "node smoke/herdr.ts",
		"smoke:schedule": "node smoke/schedule.ts",
		"smoke:dispatch": "node smoke/dispatch.ts",
		"smoke:rex-dispatch": "node smoke/rex-dispatch.ts",
		"smoke:terminal": "node smoke/terminal.ts",
		"smoke:bridge": "node smoke/bridge.ts",
		"smoke:digest": "node smoke/digest.ts",
		"smoke:respond": "node smoke/respond.ts",
		"smoke:telegram": "node smoke/telegram.ts",
		"smoke:memory": "node smoke/memory.ts",
		"smoke:inspect": "node smoke/inspect.ts",
		"smoke:signals": "node smoke/signals.ts",
		"smoke:reflection": "node smoke/reflection.ts",
		"smoke:reflection-card": "node smoke/reflection-card.ts"
	},
	"dependencies": {
		"@earendil-works/chord": "1.3.0",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-durable": "1.3.0",
		"@earendil-works/pi-mcp": "1.3.0",
		"zod": "3.25.76"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@modelcontextprotocol/server-everything": "1.0.0",
		"@types/node": "22.20.5",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	}
}
